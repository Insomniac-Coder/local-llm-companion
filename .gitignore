# Local conversations, databases, attachments, backups, and downloaded models.
/data/
/backend/data/
# Keep the folder in fresh clones, but never track downloaded model/runtime files.
/models/*
!/models/.gitkeep
# The model downloader is project code, not a downloaded artefact.
!/models/modeldownloader.py
/backups/
/backend/backups/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.gguf
*.safetensors

# Build products and installed dependencies (keep lockfiles in Git).
# The llama.cpp runtime is built from runtime/llama.cpp.lock.json; only the lock is tracked.
/build/
/runtime/*
!/runtime/llama.cpp.lock.json
/backend/target/
node_modules/
/frontend/dist/
coverage/
*.tsbuildinfo
__pycache__/
*.py[cod]
.venv/
venv/

# Machine-local configuration and secrets; safe example files may be committed.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# Runtime logs and generated evaluation traces (may contain local chat/file data).
*.log
/docs/validation/**/*.json

# Editor and OS artifacts.
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo

# The showcase model is committed, split into parts under 2 GB and stored with Git LFS
# (night decisions 51 and 55). Other models stay local.
!/models/gemma-4-e4b-it-qat/
!/models/gemma-4-e4b-it-qat/*.gguf
